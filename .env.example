# ---------------------------------------------------------------------------
# Storage mode
#   (leave unset) → use Supabase below (recommended for the real deployment)
#   local         → keep everything in .data/ on this server (preview only,
#                   no internet required; never use on serverless hosting)
# ---------------------------------------------------------------------------
# DATA_MODE=local

# ---------------------------------------------------------------------------
# Copy to .env.local and fill in your own values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
# Server-side only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private administrator account (used to seed the login on first sign-in).
# After the first login the password hash is stored in the database and can be
# changed from Admin → Settings. Remove ADMIN_PASSWORD afterwards if you like.
ADMIN_USERNAME=yousuf
ADMIN_PASSWORD=choose-a-strong-private-password

# Long random string used to sign the admin session cookie (32+ chars).
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
