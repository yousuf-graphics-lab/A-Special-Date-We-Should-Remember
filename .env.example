# ===========================================================================
#  For Samiya — environment variables
#  Copy this file to `.env.local` (local) or paste into Vercel (production).
#  NEVER commit `.env.local`.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Supabase — REQUIRED
#    Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to be public. This app never uses it to read or write
# the vault (all data access happens on the server with the service role key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 2. Admin vault — REQUIRED
# ---------------------------------------------------------------------------
# bcrypt hash of your admin password. Generate it with:
#   npm run hash-password -- "a long password"
#
# IMPORTANT: .env files expand `$`, and a bcrypt hash contains several.
# Use ADMIN_PASSWORD_BASE64 (recommended) OR escape every `$` as `\$`:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$AbCd...
ADMIN_PASSWORD_BASE64=
ADMIN_PASSWORD_HASH=

# Random, unguessable path segment. The vault lives at /vault-<ADMIN_SLUG>.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64url').toLowerCase().replace(/[^a-z0-9]/g,''))"
# Lowercase letters, numbers and dashes only, 8+ characters.
ADMIN_SLUG=

# Secret used to sign the admin session JWT (32+ characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# 3. Site URL — REQUIRED in production (Open Graph metadata / absolute URLs)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra origin allowed to iframe the site. Leave blank unless you
# embed it somewhere (WhatsApp in-app previews are allowed by default).
ALLOWED_EMBED_ORIGIN=

# ---------------------------------------------------------------------------
# 4. Notifications — OPTIONAL (each one is skipped when left blank)
# ---------------------------------------------------------------------------
# Resend (https://resend.com) — email you when Samiya sends her answer.
RESEND_API_KEY=
# A verified sender, e.g. "For Samiya <hello@yourdomain.com>"
RESEND_FROM_EMAIL=
# Where the notification goes (your own inbox).
NOTIFICATION_EMAIL_TO=
# Set to "true" to include her personal note in notifications (off by default).
NOTIFY_INCLUDE_NOTE=false

# Telegram — private message via your own bot.
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# 5. Background music — OPTIONAL
# ---------------------------------------------------------------------------
# A file you put in /public, e.g. /music/our-song.mp3
# Leave blank and the site works exactly the same (only the chime plays).
NEXT_PUBLIC_MUSIC_URL=
